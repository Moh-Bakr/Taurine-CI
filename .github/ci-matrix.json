{
  "version": 1,
  "dispatch_contracts": {
    "version": 1,
    "source_repository": "Moh-Bakr/Taurine",
    "control_repository": "Moh-Bakr/Taurine-CI",
    "control_refs": [
      "refs/heads/main",
      "refs/heads/untrusted"
    ],
    "workflows": {
      ".github/workflows/linux-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false},
          "profile": {"type": "choice", "required": false, "default": "full", "options": ["full", "quick"], "digest_include": true},
          "visual": {"type": "boolean", "required": false, "default": false, "digest_include": true},
          "gitleaks_history": {"type": "boolean", "required": false, "default": false, "digest_include": true},
          "base_sha": {"type": "string", "required": false, "default": "", "format": "optional-sha40", "digest_include": true}
        }
      },
      ".github/workflows/macos-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false},
          "rust": {"type": "boolean", "required": false, "default": false, "digest_include": true},
          "flavor": {"type": "choice", "required": false, "default": "prod", "options": ["prod", "dev", "uat"], "digest_include": true}
        }
      },
      ".github/workflows/windows-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false},
          "rust": {"type": "boolean", "required": false, "default": false, "digest_include": true},
          "windows_image": {"type": "choice", "required": false, "default": "windows-2022", "options": ["windows-2022", "windows-2025"], "digest_include": true}
        }
      },
      ".github/workflows/android-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false},
          "rust": {"type": "boolean", "required": false, "default": false, "digest_include": true}
        }
      },
      ".github/workflows/ios-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false},
          "rust": {"type": "boolean", "required": false, "default": false, "digest_include": true}
        }
      },
      ".github/workflows/orchestrate-validation.yml": {
        "inputs": {
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false}
        }
      },
      ".github/workflows/live-proofs.yml": {
        "inputs": {
          "engine": {"type": "string", "required": true, "format": "engine-selection", "options": ["doris", "starrocks", "db2", "informix", "rocketmq", "iris", "postgres", "mysql", "mssql", "pgtls", "bastion"], "digest_include": true},
          "source_sha": {"type": "string", "required": true, "format": "sha40", "digest_include": true},
          "dispatch_key": {"type": "string", "required": true, "format": "sha256", "digest_include": false}
        }
      }
    }
  },
  "rules": {
    "full_if_any_changed": [
      "Cargo.toml",
      "Cargo.lock",
      "**/Cargo.lock",
      "rust-toolchain.toml",
      "rust-toolchain",
      ".cargo/**",
      "vendor.lock",
      "scripts/vendor-openvpn3.sh",
      "scripts/patches/**",
      "package-lock.json",
      "**/package-lock.json",
      ".github/**",
      "deny.toml",
      "clippy.toml",
      "rustfmt.toml",
      ".gitleaks.toml",
      ".semgrep/**",
      ".semgrepignore"
    ],
    "docs_only": [
      "**/*.md",
      "docs/**",
      "plans/**",
      ".claude/**",
      ".gitignore",
      ".editorconfig",
      "LICENSE*"
    ],
    "max_changed_files_before_full": 3000
  },
  "excluded_trees": {
    "taurine-backend/dbx-core": [
      "rust-dbx",
      "rust-app-1",
      "rust-app-2"
    ],
    "taurine-backend/dbx-mongo-shell": [
      "rust-dbx",
      "rust-app-1",
      "rust-app-2"
    ],
    "taurine-backend/taurine-tls-openssl": [
      "rust-tls-openssl"
    ]
  },
  "concerns": {
    "linux": {
      "contracts": {
        "always": true,
        "paths": [
          "scripts/**",
          "skills/**",
          "package.json"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "held in audit until the 0.2.0 release candidate has finished: the first block proof (Linux run 37369923956) failed closed at the package install, fixed in this change, and the re-proof needs a protected run"
      },
      "frontend-build-budget": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "desktop-quality": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "desktop-shard-1": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "desktop-shard-2": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "mobile-quality": {
        "paths": [
          "taurine-mobile/**",
          "packages/**"
        ],
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "taurine-cli": {
        "rust_packages": [
          "taurine-cli"
        ],
        "timeout": 45,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-domain": {
        "rust_packages": [
          "taurine-model",
          "taurine-atomic",
          "taurine-auth",
          "taurine-crypt",
          "taurine-store",
          "taurine-repo",
          "taurine-replicate",
          "taurine-sync",
          "taurine-notes",
          "taurine-core",
          "taurine-exec",
          "taurine-scripting",
          "taurine-mock",
          "taurine-git",
          "taurine-transport-fs",
          "taurine-transport-git",
          "taurine-transport-wifi"
        ],
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-db": {
        "rust_package_glob": "taurine-db*",
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-net": {
        "rust_packages": [
          "taurine-peer-sys",
          "taurine-net",
          "taurine-ovpn-sys",
          "taurine-net-conformance"
        ],
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-app-1": {
        "rust_packages": [
          "taurine-app",
          "taurine-desktop",
          "taurine-mobile"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-app-2": {
        "rust_packages": [
          "taurine-app",
          "taurine-desktop",
          "taurine-mobile"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-dbx": {
        "excluded_trees": [
          "taurine-backend/dbx-core",
          "taurine-backend/dbx-mongo-shell"
        ],
        "full_only": true,
        "timeout": 90,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-critical": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-a11y": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-regression-1": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-regression-2": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-regression-3": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "e2e-regression-4": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-packaging": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "rust_packages": [
          "taurine-desktop"
        ],
        "timeout": 90,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "rust-tls-openssl": {
        "full_only": true,
        "timeout": 60,
        "excluded_trees": [
          "taurine-backend/taurine-tls-openssl"
        ],
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "scan-security": {
        "always": true,
        "full_only": true,
        "timeout": 90,
        "paths": [
          "**/*.rs",
          "**/*.ts",
          "**/*.tsx",
          "**/Cargo.toml",
          "**/package.json"
        ],
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern"
      },
      "scan-history": {
        "opt_in": "gitleaks_history",
        "timeout": 30,
        "egress": "audit",
        "egress_audit_reason": "staged rollout: block mode is proven on contracts first, then extended to this concern",
        "paths": [
          "**/*"
        ]
      },
      "e2e-visual": {
        "opt_in": "visual",
        "timeout": 60,
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "egress": "audit",
        "egress_audit_reason": "runs inside a job container as root with the host Docker socket; a host firewall set up before it cannot bind root inside the container"
      }
    }
  }
}
