{
  "version": 1,
  "rules": {
    "full_if_any_changed": [
      "Cargo.toml",
      "Cargo.lock",
      "**/Cargo.lock",
      "rust-toolchain.toml",
      "rust-toolchain",
      ".cargo/**",
      "vendor.lock",
      "scripts/vendor-openvpn3.sh",
      "scripts/patches/**",
      "package-lock.json",
      "**/package-lock.json",
      ".github/**",
      "deny.toml",
      "clippy.toml",
      "rustfmt.toml",
      ".gitleaks.toml",
      ".semgrep/**",
      ".semgrepignore"
    ],
    "docs_only": [
      "**/*.md",
      "docs/**",
      "plans/**",
      ".claude/**",
      ".gitignore",
      ".editorconfig",
      "LICENSE*"
    ],
    "max_changed_files_before_full": 3000
  },
  "excluded_trees": {
    "taurine-backend/dbx-core": [
      "rust-dbx",
      "rust-app"
    ],
    "taurine-backend/dbx-mongo-shell": [
      "rust-dbx",
      "rust-app"
    ],
    "taurine-backend/taurine-tls-openssl": [
      "rust-tls-openssl"
    ]
  },
  "concerns": {
    "linux": {
      "contracts": {
        "always": true,
        "paths": [
          "scripts/**",
          "skills/**",
          "package.json"
        ],
        "timeout": 30
      },
      "frontend-build-budget": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30
      },
      "desktop-quality": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30
      },
      "desktop-shard-1": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30
      },
      "desktop-shard-2": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 30
      },
      "mobile-quality": {
        "paths": [
          "taurine-mobile/**",
          "packages/**"
        ],
        "timeout": 30
      },
      "taurine-cli": {
        "rust_packages": [
          "taurine-cli"
        ],
        "timeout": 45
      },
      "rust-domain": {
        "rust_packages": [
          "taurine-model",
          "taurine-atomic",
          "taurine-auth",
          "taurine-crypt",
          "taurine-store",
          "taurine-repo",
          "taurine-replicate",
          "taurine-sync",
          "taurine-notes",
          "taurine-core",
          "taurine-exec",
          "taurine-scripting",
          "taurine-mock",
          "taurine-git",
          "taurine-transport-fs",
          "taurine-transport-git",
          "taurine-transport-wifi"
        ],
        "timeout": 60
      },
      "rust-db": {
        "rust_package_glob": "taurine-db*",
        "full_only": true,
        "timeout": 60
      },
      "rust-net": {
        "rust_packages": [
          "taurine-peer-sys",
          "taurine-net",
          "taurine-ovpn-sys",
          "taurine-net-conformance"
        ],
        "timeout": 60
      },
      "rust-app": {
        "rust_packages": [
          "taurine-app",
          "taurine-desktop",
          "taurine-mobile"
        ],
        "full_only": true,
        "timeout": 90
      },
      "rust-dbx": {
        "excluded_trees": [
          "taurine-backend/dbx-core",
          "taurine-backend/dbx-mongo-shell"
        ],
        "full_only": true,
        "timeout": 90
      },
      "e2e-critical": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "timeout": 60
      },
      "e2e-a11y": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60
      },
      "e2e-regression-1": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60
      },
      "e2e-regression-2": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60
      },
      "e2e-regression-3": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60
      },
      "e2e-regression-4": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "full_only": true,
        "timeout": 60
      },
      "rust-packaging": {
        "paths": [
          "taurine-desktop/**",
          "packages/**"
        ],
        "rust_packages": [
          "taurine-desktop"
        ],
        "timeout": 90
      },
      "rust-tls-openssl": {
        "full_only": true,
        "timeout": 60,
        "excluded_trees": [
          "taurine-backend/taurine-tls-openssl"
        ]
      },
      "scan-security": {
        "always": true,
        "full_only": true,
        "timeout": 90,
        "paths": [
          "**/*.rs",
          "**/*.ts",
          "**/*.tsx",
          "**/Cargo.toml",
          "**/package.json"
        ]
      }
    }
  }
}
